{
  "name": "jevgame-api",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "secrets": { "required": ["JEV_API_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "DECISION_QUOTA", "class_name": "DecisionQuota" }]
  },
  "exports": {
    "DecisionQuota": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [{
    "name": "REQUEST_RATE",
    "namespace_id": "38471",
    "simple": { "limit": 240, "period": 60 }
  }]
}
